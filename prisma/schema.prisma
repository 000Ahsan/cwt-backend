datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CONTRACTOR
  WORKER
}

model User {
  id              String            @id @default(uuid())
  role            Role              @default(WORKER)
  name            String
  email           String            @unique
  passwordHash    String
  contractorId    String?
  contractor      User?             @relation("ContractorToWorker", fields: [contractorId], references: [id])
  workers         User[]            @relation("ContractorToWorker")
  projects        Project[]         @relation("ContractorProjects")
  assignments     ProjectAssignment[]
  workSessions    WorkSession[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@map("users")
}

model Project {
  id              String            @id @default(uuid())
  contractorId    String
  contractor      User              @relation("ContractorProjects", fields: [contractorId], references: [id])
  name            String
  description     String?           @db.Text
  logo            String?
  latitude        Float?
  longitude       Float?
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean           @default(true)
  assignments     ProjectAssignment[]
  workSessions    WorkSession[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@map("projects")
}

model ProjectAssignment {
  id              String            @id @default(uuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId        String
  worker          User              @relation(fields: [workerId], references: [id])
  assignedAt      DateTime          @default(now())
  @@unique([projectId, workerId])
  @@map("project_assignments")
}

model WorkSession {
  id              String            @id @default(uuid())
  workerId        String
  worker          User              @relation(fields: [workerId], references: [id])
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startTime       DateTime          @default(now())
  endTime         DateTime?
  totalMinutes    Int?
  date            DateTime          @db.Date
  workLogs        WorkLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@map("work_sessions")
}

model WorkLog {
  id              String            @id @default(uuid())
  workSessionId   String
  workSession     WorkSession       @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  description     String            @db.Text
  photos          WorkPhoto[]
  createdAt       DateTime          @default(now())
  @@map("work_logs")
}

model WorkPhoto {
  id              String            @id @default(uuid())
  workLogId       String
  workLog         WorkLog           @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  filePath        String
  mimeType        String
  size            Int
  createdAt       DateTime          @default(now())
  @@map("work_photos")
}
