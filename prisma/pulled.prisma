generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid())
  role         Role                @default(WORKER)
  name         String
  email        String?             @unique
  passwordHash String
  contractorId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  categories   String?
  deletedAt    DateTime?
  image        String?
  phone        String?             @unique
  attendances  Attendance[]
  assignments  ProjectAssignment[]
  projects     Project[]           @relation("ContractorProjects")
  contractor   User?               @relation("ContractorToWorker", fields: [contractorId], references: [id])
  workers      User[]              @relation("ContractorToWorker")
  workSessions WorkSession[]

  @@index([contractorId], map: "users_contractorId_fkey")
  @@map("users")
}

model Project {
  id              String              @id @default(uuid())
  contractorId    String
  name            String
  description     String?             @db.Text
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  endDate         DateTime?
  latitude        Float?
  logo            String?
  longitude       Float?
  startDate       DateTime?
  categories      String?
  address         String?             @db.Text
  targetHours     Float?
  isLocationBound Boolean             @default(false)
  assignments     ProjectAssignment[]
  contractor      User                @relation("ContractorProjects", fields: [contractorId], references: [id])
  workSessions    WorkSession[]

  @@index([contractorId], map: "projects_contractorId_fkey")
  @@map("projects")
}

model Attendance {
  id           String    @id @default(uuid())
  userId       String
  loginTime    DateTime  @default(now())
  logoutTime   DateTime?
  isAutoLogout Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "attendances_userId_fkey")
  @@map("attendances")
}

model ProjectAssignment {
  id         String   @id @default(uuid())
  projectId  String
  workerId   String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker     User     @relation(fields: [workerId], references: [id])

  @@unique([projectId, workerId])
  @@index([workerId], map: "project_assignments_workerId_fkey")
  @@map("project_assignments")
}

model WorkSession {
  id           String             @id @default(uuid())
  workerId     String
  projectId    String
  startTime    DateTime           @default(now())
  endTime      DateTime?
  totalMinutes Int?
  date         DateTime           @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     String?
  status       WorkSessionStatus  @default(ACTIVE)
  workLogs     WorkLog[]
  pauses       WorkSessionPause[]
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker       User               @relation(fields: [workerId], references: [id])

  @@index([projectId], map: "work_sessions_projectId_fkey")
  @@index([workerId], map: "work_sessions_workerId_fkey")
  @@map("work_sessions")
}

model WorkSessionPause {
  id              String      @id @default(uuid())
  workSessionId   String
  pauseTime       DateTime    @default(now())
  resumeTime      DateTime?
  durationMinutes Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workSession     WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([workSessionId], map: "work_session_pauses_workSessionId_fkey")
  @@map("work_session_pauses")
}

model WorkLog {
  id                String        @id @default(uuid())
  workSessionId     String
  description       String        @db.Text
  createdAt         DateTime      @default(now())
  contractorComment String?       @db.Text
  status            WorkLogStatus @default(PENDING)
  workSession       WorkSession   @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  photos            WorkPhoto[]

  @@index([workSessionId], map: "work_logs_workSessionId_fkey")
  @@map("work_logs")
}

model WorkPhoto {
  id        String   @id @default(uuid())
  workLogId String
  filePath  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  workLog   WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@index([workLogId], map: "work_photos_workLogId_fkey")
  @@map("work_photos")
}

enum Role {
  CONTRACTOR
  WORKER
}

enum WorkLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}
