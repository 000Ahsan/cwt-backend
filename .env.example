# Application
NODE_ENV=production
PORT=3000

# MySQL (used by docker-compose.yml for the mysql service)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME

# Prisma — hostname MUST be `mysql` on the Docker network (not localhost)
DATABASE_URL=mysql://fieldhq:CHANGE_ME@mysql:3306/fieldhq

# JWT (required — app reads these exact names)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# CORS — comma-separated origins (app reads ALLOWED_ORIGINS, not CORS_ORIGINS)
ALLOWED_ORIGINS=https://app.fieldhqapp.com

# Local uploads directory inside the container (bind-mounted from ./uploads)
# The Nest ServeStaticModule currently serves process.cwd()/uploads (= /app/uploads).
UPLOAD_DIR=/app/uploads

# Cloudinary (used for profile images, logos, and work-log photo uploads)
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
